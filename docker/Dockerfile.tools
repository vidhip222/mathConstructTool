# Dockerfile.tools — MathConstruct sandbox with all free math solvers pre-installed.
#
# Build:
#   docker build -t mathconstruct-tools -f docker/Dockerfile.tools docker/
#
# This image is used by ToolSolver when running tool code in Docker.
# It extends the base Python image with:
#   - z3-solver, ortools, pycryptosat, networkx, sympy, scipy, numpy
#   - MiniZinc (binary)
#   - SageMath (optional — large; comment out if not needed)
#
# GAP and Lean are installed separately on the host (not in Docker) because
# they are large systems best managed via package managers on the host OS.

FROM python:3.12-slim

# --------------------------------------------------------------------------
# System dependencies
# --------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        wget curl unzip ca-certificates \
        build-essential libgmp-dev libmpfr-dev \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------------------
# MiniZinc binary
# --------------------------------------------------------------------------
ARG MINIZINC_VERSION=2.8.5
RUN wget -q "https://github.com/MiniZinc/MiniZincIDE/releases/download/${MINIZINC_VERSION}/MiniZincIDE-${MINIZINC_VERSION}-bundle-linux-x86_64.tgz" \
        -O /tmp/minizinc.tgz \
    && mkdir -p /opt/minizinc \
    && tar -xzf /tmp/minizinc.tgz -C /opt/minizinc --strip-components=1 \
    && rm /tmp/minizinc.tgz \
    && ln -s /opt/minizinc/bin/minizinc /usr/local/bin/minizinc

# --------------------------------------------------------------------------
# Python packages
# --------------------------------------------------------------------------
RUN pip install --no-cache-dir \
        z3-solver \
        ortools \
        pycryptosat \
        networkx \
        sympy \
        scipy \
        numpy

# --------------------------------------------------------------------------
# SageMath (comment out to keep image small; takes ~3 GB)
# --------------------------------------------------------------------------
# RUN apt-get update && apt-get install -y sagemath && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------------------------
# Security: drop privileges
# --------------------------------------------------------------------------
RUN useradd -m sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["python"]
